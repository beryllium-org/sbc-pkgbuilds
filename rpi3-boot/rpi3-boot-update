#!/usr/bin/sh
set -e

if [ "$(id -u)" -ne 0 ]; then
  echo "rpi3-boot-update must be run as root." >&2
  exit 1
fi

config_src=/etc/rpi-boot/config.txt
config_dst=/boot/config.txt
u_boot_src=/etc/rpi-boot/u-boot.bin
u_boot_dst=/boot/u-boot.bin

comment="# Auto-generated by rpi3-boot-update. Edit /etc/rpi-boot/config.txt and rerun."

tmp=$(mktemp)
trap 'rm -f "$tmp"' EXIT
{
  echo "$comment"
  cat "$config_src"
} > "$tmp"
cp "$tmp" "$config_dst"
cp "$u_boot_src" "$u_boot_dst"
