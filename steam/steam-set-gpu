#!/bin/bash
#
# steam-set-gpu - choose which GPU the arm64 Steam client and its games use
# on hybrid systems (e.g. onboard Mali + an AMD dGPU).
#
#   steam-set-gpu           interactive pick
#   steam-set-gpu <N>       pick GPU number N directly
#   steam-set-gpu --list    just enumerate
#   steam-set-gpu --clear   back to automatic (removes the override)
#
# Writes ~/.local/share/Steam/gpu.conf, which /usr/bin/steam sources on every
# launch and exports as MESA_VK_DEVICE_SELECT (Vulkan: the ICD-level filter -
# radv/panvk/DXVK/VKD3D all see only the chosen device) and DRI_PRIME (GL).
# Plain env vars, so they reach the client, FEX-thunked and Proton games alike.

set -eo pipefail

CONF="${HOME}/.local/share/Steam/gpu.conf"

# vulkaninfo --summary emits one block per device; pull out the four fields
# we care about. Devices that fail to initialize are skipped by the loader
# automatically, so a dead dGPU simply doesn't appear.
enumerate() {
  vulkaninfo --summary 2>/dev/null | awk '
    /^GPU[0-9]+:/ { n = $1; gsub(/GPU|:/, "", n) }
    /^[ \t]*deviceName[ \t]*=/ { sub(/^[ \t]*deviceName[ \t]*=[ \t]*/, "");   name[n]   = $0 }
    /^[ \t]*vendorID[ \t]*=/   { sub(/^[ \t]*vendorID[ \t]*=[ \t]*/, "");     vendor[n] = $0 }
    /^[ \t]*deviceID[ \t]*=/   { sub(/^[ \t]*deviceID[ \t]*=[ \t]*/, "");     device[n] = $0 }
    /^[ \t]*driverName[ \t]*=/ { sub(/^[ \t]*driverName[ \t]*=[ \t]*/, "");   driver[n] = $0 }
    END {
      for (n = 0; n < 64; n++)
        if (n in name)
          printf "%d\t%s\t%s\t%s\t%s\n", n, name[n], vendor[n], device[n], driver[n]
    }'
}

# Find the DRM render node whose PCI ID matches vendor:device (lowercase hex,
# without 0x). Platform GPUs (Mali) have no PCI ID and get no GL override.
find_render_node() {
  local uev pid p d node
  for uev in /sys/class/drm/renderD*/device/uevent; do
    pid=$(grep -m1 '^PCI_ID=' "${uev}" 2>/dev/null | cut -d= -f2)
    [ -n "${pid}" ] || continue
    p=${pid%%:*}; d=${pid#*:}
    p=${p#0x}; d=${d#0x}
    if [ "${p}:${d}" = "$1" ]; then
      node=$(basename "$(dirname "${uev}")")
      echo "/dev/dri/${node}"
      return 0
    fi
  done
  return 1
}

norm_id() { printf '%s' "$1" | sed 's/^0x//' | tr 'A-F' 'a-f'; }

case "${1:-}" in
  --clear)
    rm -f "${CONF}"
    echo "GPU override cleared; Steam goes back to automatic selection."
    exit 0
    ;;
  --list)
    enumerate
    exit 0
    ;;
  '')
    enumerate > /tmp/.steam-set-gpu.$$
    if ! [ -s /tmp/.steam-set-gpu.$$ ]; then
      rm -f /tmp/.steam-set-gpu.$$
      echo "No Vulkan devices enumerated - check your drivers (vulkaninfo)." >&2
      exit 1
    fi
    echo "Available GPUs:"
    awk -F'\t' '{ printf "  %d: %s (%s, %s:%s)\n", $1, $2, $5, $3, $4 }' /tmp/.steam-set-gpu.$$
    printf 'Use which GPU? [%d-%d, empty=cancel] ' 0 $(($(wc -l < /tmp/.steam-set-gpu.$$) - 1))
    read -r PICK
    rm -f /tmp/.steam-set-gpu.$$
    [ -n "${PICK}" ] || exit 0
    set -- "${PICK}"
    ;;
esac

# <N> form: pick directly.
ROW=$(enumerate | awk -F'\t' -v want="$1" '$1 == want')
if [ -z "${ROW}" ]; then
  echo "No GPU number '${1}' (see: steam-set-gpu --list)" >&2
  exit 1
fi

NAME=$(awk -F'\t' '{print $2}' <<<"${ROW}")
VID=$(norm_id "$(awk -F'\t' '{print $3}' <<<"${ROW}")")
DID=$(norm_id "$(awk -F'\t' '{print $4}' <<<"${ROW}")")
DRV=$(awk -F'\t' '{print $5}' <<<"${ROW}")

{
  echo "# Generated by steam-set-gpu; sourced by /usr/bin/steam on every launch."
  echo "# Selected: ${NAME} (${DRV}, ${VID}:${DID})"
  echo "MESA_VK_DEVICE_SELECT=\"${VID}:${DID}\""
  if NODE=$(find_render_node "${VID}:${DID}"); then
    echo "DRI_PRIME=${NODE}"
  else
    echo "# No matching PCI render node (platform GPU?) - GL follows the default device."
  fi
} > "${CONF}"

echo "GPU override written to ${CONF}:"
cat "${CONF}"
echo "Restart Steam to apply."
